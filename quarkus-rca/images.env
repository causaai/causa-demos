# =============================================================================
# images.env — Image overrides for demo.sh
# =============================================================================
# Loaded automatically by demo.sh at startup.
# These values are passed as --<component>-image flags to install.sh.
# Leave a variable unset (or empty) to use the installer's own default.
#
# Current images for the quarkus-rca demo (kind target):
#   causa-backend:         quay.io/rh-ee-shesaxen/causa-backend:adc-fix
#   causa-mcp-server:      quay.io/bmenghan/causa-mcp-server:latest
#   k8s-mcp-server:        quay.io/containers/kubernetes_mcp_server:v0.0.62
#
# Async profiler, async-profiler-mcp, and quarkus-mcp images are not yet
# available — install.sh skips those components gracefully (non-fatal warnings).
# Once the images are published, add them here.
# =============================================================================

# Kubernetes MCP server
K8S_MCP_SERVER_IMAGE=quay.io/containers/kubernetes_mcp_server:v0.0.62

# Causa backend (adc-fix branch — supports POST /api/v1/configs and GOOGLE_APPLICATION_CREDENTIALS as base64)
CAUSA_BACKEND_IMAGE=quay.io/rh-ee-shesaxen/causa-backend:adc-fix

# Causa MCP server (exposes initiate_rca + get_rca_result tools used by the SKILL.md)
CAUSA_MCP_IMAGE=quay.io/bmenghan/causa-mcp-server:latest

# Async Profiler — image not yet available; install.sh skips gracefully
# ASYNC_PROFILER_IMAGE=quay.io/causaai/async-profiler:latest

# Async Profiler MCP — image not yet available; install.sh skips gracefully
# ASYNC_PROFILER_MCP_IMAGE=quay.io/causaai/async-profiler-mcp:latest

# Quarkus MCP — image not yet available; install.sh skips gracefully
# QUARKUS_MCP_IMAGE=quay.io/causaai/quarkus-mcp:latest
