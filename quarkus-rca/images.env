# =============================================================================
# images.env — Image overrides for demo.sh
# =============================================================================
# Loaded automatically by demo.sh at startup.
# These values are passed as --<component>-image flags to install.sh.
# Leave a variable unset (or empty) to use the installer's own default.
#
# Current images for the quarkus-rca demo (kind target):
#   causa-backend:         quay.io/causa-ai-hub/causa-backend:0.0.2
#   causa-mcp-server:      quay.io/causa-ai-hub/causa-mcp-server:0.0.1
#   k8s-mcp-server:        quay.io/containers/kubernetes_mcp_server:v0.0.62
#   jafra-mcp-server:      quay.io/causa-ai-hub/jafra-mcp-server:0.1.0
#   quarkus-mcp:           quay.io/causa-ai-hub/quarkus-mcp:0.0.1
# =============================================================================

# Kubernetes MCP server
K8S_MCP_SERVER_IMAGE=${K8S_MCP_SERVER_IMAGE:-quay.io/containers/kubernetes_mcp_server:v0.0.62}

# Causa Backend — RCA engine
CAUSA_BACKEND_IMAGE=${CAUSA_BACKEND_IMAGE:-quay.io/causa-ai-hub/causa-backend:0.0.2}

# Jafra MCP Server
JAFRA_MCP_IMAGE=${JAFRA_MCP_IMAGE:-quay.io/causa-ai-hub/jafra-mcp-server:0.0.1}

# Causa MCP Server
CAUSA_MCP_IMAGE=${CAUSA_MCP_IMAGE:-quay.io/causa-ai-hub/causa-mcp-server:0.0.1}

# Quarkus MCP Server
QUARKUS_MCP_IMAGE=${QUARKUS_MCP_IMAGE:-quay.io/causa-ai-hub/quarkus-mcp:0.0.1}

# Jafra Controller
JAFRA_CONTROLLER_IMAGE=${JAFRA_CONTROLLER_IMAGE:-quay.io/causa-ai-hub/jafra-controller:0.0.1}

# Jafra Analyzer
JAFRA_ANALYZER_IMAGE=${JAFRA_ANALYZER_IMAGE:-quay.io/causa-ai-hub/jafra-analyzer:0.0.1}

# Jafra Agent
JAFRA_AGENT_IMAGE=${JAFRA_AGENT_IMAGE:-quay.io/causa-ai-hub/jafra-agent:0.0.1}

# PostgreSQL — kind target (standalone Deployment, pgvector-enabled image)
POSTGRES_KIND_IMAGE=${POSTGRES_KIND_IMAGE:-docker.io/pgvector/pgvector:pg17}
export POSTGRES_KIND_IMAGE

# PostgreSQL — OpenShift target (CNPG operand image, managed by CloudNativePG operator)
POSTGRES_OCP_IMAGE=${POSTGRES_OCP_IMAGE:-quay.io/causa-ai-hub/postgres-pgvector:17}
export POSTGRES_OCP_IMAGE
