# =============================================================================
# llm.env.example — LLM and alert cooldown configuration for Causa Backend
# =============================================================================
#
# USAGE
# -----
# Copy this file to llm.env and fill in your values:
#
#   cp llm.env.example llm.env
#   # edit llm.env with your project ID and model settings
#   ./demo.sh
#
# llm.env is gitignored — never commit it (it contains credentials).
# demo.sh sources llm.env automatically at Step 2b if it exists.
# Alternatively, export the variables before running:
#
#   export VERTEX_PROJECT_ID=my-gcp-project
#   ./demo.sh
#
# WHAT THIS CONTROLS
# ------------------
# After the installer completes, the demo script calls POST /api/v1/configs on
# Causa Backend (Step 2b). This pushes LLM credentials and alert cooldown into
# the running instance without a pod restart.
#
# If VERTEX_PROJECT_ID is not set, only the cooldown is pushed. Causa will
# still perform RCA using heuristics — just without LLM-generated explanations.
# =============================================================================


# =============================================================================
# Vertex AI Anthropic (Claude on GCP) — required for LLM-powered RCA
# =============================================================================

# GCP project ID that has the Vertex AI API enabled and Claude models available.
VERTEX_PROJECT_ID=your-gcp-project-id

# GCP region where the Vertex AI Anthropic endpoint is available.
# Supported: us-east5, us-central1, europe-west1
VERTEX_LOCATION=us-east5

# Claude model name as seen in the Vertex AI model garden.
LLM_MODEL_NAME=claude-sonnet-4-6

# LLM provider — must be "vertex-ai-anthropic" for Claude on GCP.
LLM_PROVIDER=vertex-ai-anthropic


# =============================================================================
# Alert cooldown (optional)
# =============================================================================

# Cooldown in MINUTES. Causa suppresses duplicate alerts with the same
# alert_name + workload_name within this window.
# Default: 1 minute (fine for the demo — each OOMKill gets a fresh alert_id).
#CAUSA_ALERT_COOLDOWN=1


# =============================================================================
# GCP service account key — NOT set here
# =============================================================================
#
# Do NOT add GOOGLE_APPLICATION_CREDENTIALS to this file.
#
# The demo script reads the GCP key from the causa-gcp-credentials K8s Secret
# and sends it to Causa as a base64 blob via POST /api/v1/configs.
# The adc-fix branch of Causa Backend reads the value via Base64.decode() —
# it expects a base64 blob, NOT a file path.
#
# Place your GCP service account key JSON at:
#   quarkus-rca/causa-gcp-key.json   (gitignored — never commit)
#
# The demo script auto-creates the causa-gcp-credentials K8s Secret from it
# at Step 2b if the secret does not already exist.
#
# To create the GCP service account and download the key:
#
#   gcloud iam service-accounts create causa-llm-sa \
#     --project="${VERTEX_PROJECT_ID}"
#
#   gcloud projects add-iam-policy-binding "${VERTEX_PROJECT_ID}" \
#     --member="serviceAccount:causa-llm-sa@${VERTEX_PROJECT_ID}.iam.gserviceaccount.com" \
#     --role="roles/aiplatform.user" --condition=None
#
#   gcloud iam service-accounts keys create causa-gcp-key.json \
#     --iam-account="causa-llm-sa@${VERTEX_PROJECT_ID}.iam.gserviceaccount.com"
