# =============================================================================
# llm.env — Backend LLM Configuration for demo.sh
# =============================================================================
#
# SETUP
#   1. Copy this file:  cp llm.env.example llm.env
#
# Causa Architecture:
#   ┌────────────────────────────────────────────────────────┐
#   │               Frontend Assistant (Chat)                │
#   │             (Bob IDE, Claude Desktop)    │
#   │                       │                                │
#   │                       ▼ (Calls MCP Tools)              │
#   │            Causa MCP Server (:30005)                   │
#   │                       │                                │
#   │                       ▼ (POST /api/v1/diagnostics)     │
#   │              Causa Backend (:30001)                    │
#   │                       │                                │
#   │                       ▼ (Generates RCA via LLM)        │
#   │       Backend RCA LLM (Vertex AI, Bob, etc.)           │
#   └────────────────────────────────────────────────────────┘
#
# ⚠️  NEVER commit llm.env to Git — it contains sensitive credentials.
#     llm.env is already listed in .gitignore.
#
# =============================================================================


# =============================================================================
# PART 1: BACKEND RCA LLM PROVIDER (Causa Backend)
# =============================================================================
# Choose which LLM provider Causa Backend uses to generate root cause analysis.
#
# Supported Providers:
#   vertex-ai-anthropic  — Claude via Google Cloud Vertex AI (Default)
#   anthropic            — Direct Claude API (Anthropic API Key)
#   bob                  — IBM Bob
# =============================================================================

LLM_PROVIDER=vertex-ai-anthropic


# -----------------------------------------------------------------------------
# 1. PROVIDER: vertex-ai-anthropic (Google Cloud Vertex AI Claude)
# -----------------------------------------------------------------------------
# Required when LLM_PROVIDER=vertex-ai-anthropic:
#   VERTEX_PROJECT_ID               GCP project ID
#   VERTEX_LOCATION                 GCP region (e.g. us-east5, us-central1)
#   GOOGLE_APPLICATION_CREDENTIALS   Path to GCP service account key json
# -----------------------------------------------------------------------------

# Claude model name on Vertex AI
LLM_MODEL_NAME=claude-sonnet-4-6

# GCP project ID with Vertex AI API enabled (run: gcloud projects list)
VERTEX_PROJECT_ID=

# Vertex AI region (us-east5 | us-central1 | europe-west1 | asia-southeast1)
VERTEX_LOCATION=us-east5

# Path to service account key file (or place causa-gcp-key.json in this dir)
GOOGLE_APPLICATION_CREDENTIALS=./causa-gcp-key.json


# -----------------------------------------------------------------------------
# 2. PROVIDER: bob (IBM Bob)
# -----------------------------------------------------------------------------
# Used when Causa backend invokes Bob for diagnostics generation.
# -----------------------------------------------------------------------------

# LLM_PROVIDER=bob
# LLM_API_KEY=your-bob-api-key   # Required if Bob requires API key authentication
# BOB_PATH=bob                  # Optional: custom path to bob binary (default: bob)


# -----------------------------------------------------------------------------
# 3. PROVIDER: anthropic (Direct Anthropic API)
# -----------------------------------------------------------------------------
# Direct API key access to Anthropic Claude (https://console.anthropic.com/settings/keys)
# -----------------------------------------------------------------------------

# LLM_PROVIDER=anthropic
# LLM_MODEL_NAME=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-api03-...


# =============================================================================
# PART 2: FRONTEND CHAT ASSISTANT
# =============================================================================
# Choose which assistant UI you want to automatically configure for RCA chat.
# If left commented out or empty, automatic MCP client configuration is skipped.
# You can also pass `--frontend bob|claude|all|none` to demo.sh.
#
# Supported:
#   bob    — Configure Bob IDE (~/.bob/settings/mcp.json) and install causa-rca skill
#   claude — Configure Claude Desktop (claude_desktop_config.json)
#   all    — Configure both Bob IDE and Claude Desktop
#   none   — Skip automatic MCP client registration
# =============================================================================

# FRONTEND_ASSISTANT=bob
