# =============================================================================
# llm.env — Backend LLM Configuration for demo.sh
# =============================================================================
#
# SETUP
#   1. Copy this file:  cp llm.env.example llm.env
#
# Causa Architecture:
#   ┌────────────────────────────────────────────────────────┐
#   │           AI Assistant (any MCP-capable IDE)           │
#   │      (Bob IDE, Claude shell, Cursor, Windsurf, …)      │
#   │                       │                                │
#   │                       ▼ (Calls MCP Tools via .mcp.json)│
#   │            Causa MCP Server (:30005)                   │
#   │                       │                                │
#   │                       ▼ (POST /api/v1/diagnostics)     │
#   │              Causa Backend (:30001)                    │
#   │                       │                                │
#   │                       ▼ (Generates RCA via LLM)        │
#   │       Backend RCA LLM (Vertex AI, Bob, etc.)           │
#   └────────────────────────────────────────────────────────┘
#
# ⚠️  NEVER commit llm.env to Git — it contains sensitive credentials.
#     llm.env is already listed in .gitignore.
#
# =============================================================================


# =============================================================================
# PART 1: BACKEND RCA LLM PROVIDER (Causa Backend)
# =============================================================================
# Choose which LLM provider Causa Backend uses to generate root cause analysis.
#
# Supported Providers:
#   vertex-ai-anthropic  — Claude via Google Cloud Vertex AI (Default)
#   anthropic            — Direct Claude API (Anthropic API Key)
#   bob                  — IBM Bob
# =============================================================================

LLM_PROVIDER=vertex-ai-anthropic


# -----------------------------------------------------------------------------
# 1. PROVIDER: vertex-ai-anthropic (Google Cloud Vertex AI Claude)
# -----------------------------------------------------------------------------
# Required when LLM_PROVIDER=vertex-ai-anthropic:
#   VERTEX_PROJECT_ID               GCP project ID
#   VERTEX_LOCATION                 GCP region (e.g. us-east5, us-central1)
#   GOOGLE_APPLICATION_CREDENTIALS  Path to a GCP credentials JSON file
#                                   (see Option A and Option B below)
#
# The demo script reads this file, base64-encodes its contents, and posts
# the result to the Causa Backend config API as GOOGLE_APPLICATION_CREDENTIALS.
# Both ADC JSON (Option A) and service-account key files (Option B) are
# supported — the backend decodes and loads whichever type is present.
# -----------------------------------------------------------------------------

# Claude model name on Vertex AI
LLM_MODEL_NAME=claude-sonnet-4-6

# GCP project ID with Vertex AI API enabled (run: gcloud projects list)
VERTEX_PROJECT_ID=

# Vertex AI region (us-east5 | us-central1 | europe-west1 | asia-southeast1)
VERTEX_LOCATION=us-east5

# ---------------------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS — path to your GCP credentials file
#
# Option A: Application Default Credentials (quickest for local dev)
# ---------------------------------------------------------------------------
#
#   Step 1 — Log in and set your project:
#     gcloud auth application-default login
#     gcloud auth application-default set-quota-project <your-gcp-project-id>
#
#   Step 2 — Set the path (typical locations):
#     Linux / macOS : ~/.config/gcloud/application_default_credentials.json
#     Windows       : %APPDATA%\gcloud\application_default_credentials.json
#
#   GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
#
# ⚠️  ADC credentials are personal and short-lived.
#     Use Option B for shared or CI/CD environments.
#
# ---------------------------------------------------------------------------
# Option B: Service account key (recommended for shared / CI/CD environments)
# ---------------------------------------------------------------------------
#
#   Step 1 — Create the service account:
#     gcloud iam service-accounts create causa-llm-sa \
#       --project=<your-gcp-project-id>
#
#   Step 2 — Grant Vertex AI access:
#     gcloud projects add-iam-policy-binding <your-gcp-project-id> \
#       --member="serviceAccount:causa-llm-sa@<your-gcp-project-id>.iam.gserviceaccount.com" \
#       --role="roles/aiplatform.user" \
#       --condition=None
#
#   Step 3 — Download the key file to the repo root:
#     gcloud iam service-accounts keys create causa-gcp-key.json \
#       --iam-account=causa-llm-sa@<your-gcp-project-id>.iam.gserviceaccount.com
#
#   Step 4 — Set the path:
#     GOOGLE_APPLICATION_CREDENTIALS=./causa-gcp-key.json
#
# ⚠️  Sensitive — do not commit to Git. causa-gcp-key.json is gitignored.
# ---------------------------------------------------------------------------

# Uncomment and set ONE of the paths below:
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=./causa-gcp-key.json


# -----------------------------------------------------------------------------
# 2. PROVIDER: bob (IBM Bob)
# -----------------------------------------------------------------------------
# Used when Causa backend invokes Bob for diagnostics generation.
# -----------------------------------------------------------------------------

# LLM_PROVIDER=bob
# LLM_API_KEY=your-bob-api-key   # Required if Bob requires API key authentication


# -----------------------------------------------------------------------------
# 3. PROVIDER: anthropic (Direct Anthropic API)
# -----------------------------------------------------------------------------
# Direct API key access to Anthropic Claude (https://console.anthropic.com/settings/keys)
# -----------------------------------------------------------------------------

# LLM_PROVIDER=anthropic
# LLM_MODEL_NAME=claude-sonnet-4-6
# LLM_API_KEY=sk-ant-api03-...
